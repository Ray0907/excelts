{
  "name": "@raytien/excelts",
  "version": "0.1.0-beta.0",
  "description": "Fast TypeScript xlsx reader and writer with an exceljs-compatible API",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ray0907/excelts.git"
  },
  "bugs": {
    "url": "https://github.com/Ray0907/excelts/issues"
  },
  "homepage": "https://github.com/Ray0907/excelts#readme",
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "exceljs",
    "typescript",
    "reader",
    "writer"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compat": {
      "types": "./dist/compat/index.d.ts",
      "default": "./dist/compat/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "verify": "TZ=UTC node verify/run.mjs",
    "verify:self-test": "TZ=UTC node verify/run.mjs --self-test",
    "validate:xsd": "node validate/run.mjs",
    "security": "node security/run.mjs",
    "security:props": "vitest run security",
    "verify:text": "node verify/text-roundtrip.mjs --full",
    "bench": "node bench/run.mjs",
    "bench:read": "node bench/read-run.mjs",
    "bench:inputs": "node bench/gen-inputs.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "exceljs": "4.4.0",
    "fast-check": "^4.10.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "xlsx": "^0.18.5"
  }
}
